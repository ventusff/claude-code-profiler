# Local notes & scratch — not part of the published plugin.
# Specific design notes that document a change set are exempted below.
# Note: must ignore contents (`notes/*`) rather than the directory (`notes/`),
# otherwise git can't re-include individual files via `!` rules.
notes/*
!notes/subagent-coverage.md

# Profiler runtime artifacts (when the profiler is run from this repo)
runs/
state/
*.profile.json
*.profile.md
events.jsonl

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.eggs/
*.egg-info/
.pytest_cache/
uv.lock

# Editor / OS
.vscode/
.idea/
.DS_Store
*.swp

# Claude project-local settings (the plugin itself ships in .claude-plugin/, skills/, scripts/)
.claude/settings.local.json
